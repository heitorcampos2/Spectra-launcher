<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="spectra_bg">#0E0B2A</color>
    <color name="spectra_accent">#E0135A</color>

    <style name="Theme.Spectra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/spectra_bg</item>
        <item name="android:colorAccent">@color/spectra_accent</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
